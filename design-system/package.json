{
  "name": "@earnings-summary/design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Prototyping sandbox React port of the earnings-summary Python UI kit (src/ui/). NOT the canonical design system — see README.md.",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./index.css": "./dist/index.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build.mjs",
    "check:types": "bun check --no-script",
    "check:types:local": "tsrs --noEmit",
    "check:tokens": "bun scripts/check-tokens.mjs",
    "check": "bun run check:types && bun run check:tokens",
    "dev": "bun build.mjs --watch"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsrs": "7.1.0-beta.tsrs3",
    "typescript": "^5.6.0"
  },
  "packageManager": "bun@1.4.5"
}
