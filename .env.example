# earnings-summary pipeline — environment configuration
# Copy this file to `.env` (same directory) and fill in real values.
# .env is gitignored.

# ─────────────────────────────────────────────────────────────────────
# LLM ACCESS
# ─────────────────────────────────────────────────────────────────────
# Primary path: Claude Code CLI (subscription billing). No env var needed —
# auth lives in the CLI's own config (`claude auth login`).
#
# IMPORTANT: ANTHROPIC_API_KEY must NOT be set anywhere (here, shell, or
# system env). If set, the Claude CLI silently bills against the metered
# Anthropic API instead of your subscription. src/llm_client.py refuses
# to start if it's present.

# Fallback path: Gemini (google-generativeai). Used automatically when the
# Claude CLI fails (timeout, non-zero exit, empty output, binary missing).
# Fallback model: gemini-2.5-flash. Cost: sub-penny per call.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Other secrets used elsewhere in the pipeline (add if/when needed):
#   FMP_API_KEY=        # Financial Modeling Prep
#   YOUTUBE_API_KEY=    # transcript fetcher (optional)
# ─────────────────────────────────────────────────────────────────────
