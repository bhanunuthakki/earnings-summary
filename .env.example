# earnings-summary pipeline — environment configuration
# Copy this file to `.env` (same directory) and fill in real values.
# .env is gitignored.

# ─────────────────────────────────────────────────────────────────────
# LLM ACCESS (fleet preference: gemini > claude; codex disabled)
# ─────────────────────────────────────────────────────────────────────
# Preferred Gemini Developer API path (`google-genai`):
#   - Driver: gemini-4-neon | Workhorse/fallback: gemini-4-hydrogen
#   - Get a paid-tier key at https://aistudio.google.com/apikey
#   - Resolved here first, then AGENT_INSTRUCTIONS_HOME/.env if unset.
GEMINI_API_KEY=

# External model family / fallback: Claude Code CLI subprocess. Either auth
# mode works — pick one:
#   - Set ANTHROPIC_API_KEY below for metered API billing.
#   - Or run `claude auth login` for Pro/Max subscription billing instead;
#     in that case leave ANTHROPIC_API_KEY blank.
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Other secrets used elsewhere in the pipeline (add if/when needed):
#   FMP_API_KEY=        # Financial Modeling Prep
#   YOUTUBE_API_KEY=    # transcript fetcher (optional)
# ─────────────────────────────────────────────────────────────────────
