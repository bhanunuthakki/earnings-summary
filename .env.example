# earnings-summary pipeline — environment configuration
# Copy this file to `.env` (same directory) and fill in real values.
# .env is gitignored.

# ─────────────────────────────────────────────────────────────────────
# LLM ACCESS
# ─────────────────────────────────────────────────────────────────────
# Primary path: Claude Code CLI invoked as a subprocess. Either auth mode
# works — pick one:
#   - Set ANTHROPIC_API_KEY below for metered API billing (the default).
#   - Or run `claude auth login` for Pro/Max subscription billing instead;
#     in that case leave ANTHROPIC_API_KEY blank.
ANTHROPIC_API_KEY=

# Fallback path: Gemini (google-generativeai). Used automatically when the
# Claude CLI fails (timeout, non-zero exit, empty output, binary missing).
# Fallback model: gemini-2.5-flash. Cost: sub-penny per call.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Other secrets used elsewhere in the pipeline (add if/when needed):
#   FMP_API_KEY=        # Financial Modeling Prep
#   YOUTUBE_API_KEY=    # transcript fetcher (optional)
# ─────────────────────────────────────────────────────────────────────
