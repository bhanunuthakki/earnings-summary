#!/bin/sh
# earnings-summary pre-push gate: fail closed on its interpreter/tooling and
# preserve the repository's diff-aware fast/full test paths.

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

run() { printf '>> %s\n' "$*" >&2; "$@" || { printf 'PRE-PUSH FAILED at: %s\n' "$*" >&2; exit 1; }; }

resolve_python() {
  if [ -n "${PYTHON_BIN:-}" ]; then
    case "$PYTHON_BIN" in
      */*) [ -x "$PYTHON_BIN" ] || { printf 'PRE-PUSH FAILED: PYTHON_BIN is not executable: %s\n' "$PYTHON_BIN" >&2; return 1; }; printf '%s\n' "$PYTHON_BIN" ;;
      *) command -v "$PYTHON_BIN" 2>/dev/null || { printf 'PRE-PUSH FAILED: PYTHON_BIN is not on PATH: %s\n' "$PYTHON_BIN" >&2; return 1; } ;;
    esac
    return 0
  fi
  for candidate in .venv/bin/python3 .venv/bin/python .venv/Scripts/python.exe; do
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  printf 'PRE-PUSH FAILED: no project Python interpreter; set PYTHON_BIN or create .venv.\n' >&2
  return 1
}

python_bin=$(resolve_python) || exit 1
run "$python_bin" execution/verify_public_tree.py
run "$python_bin" -m ruff --version
run "$python_bin" -m pytest --version
run "$python_bin" execution/validate_directive_manifest.py
run "$python_bin" execution/validate_folder_contract.py

base=$(git merge-base HEAD origin/main 2>/dev/null || git rev-parse HEAD~1 2>/dev/null || true)
[ -n "$base" ] || { printf 'PRE-PUSH FAILED: no comparison revision.\n' >&2; exit 1; }
# The committed candidate is the push boundary. Make uses worktree mode instead.
export PYTHONPATH="$root/src${PYTHONPATH:+:$PYTHONPATH}"
run "$python_bin" -m quality.check_changed --base "$base" --mode committed --check format --check lint --check suppressions

# Full Pyright ceilings remain in CI. Both local paths preserve the public guard.
if [ "${FAST_PUSH:-0}" = "1" ]; then
  run "$python_bin" -m quality.check_changed --base "$base" --mode committed --check tests
else
  run "$python_bin" -m quality.check_changed --base "$base" --mode committed --check full-tests
fi

printf 'pre-push gate passed.\n' >&2
exit 0
