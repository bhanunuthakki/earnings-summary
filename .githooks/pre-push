#!/bin/sh
# earnings-summary pre-push gate: check changed Python files and public boundary.
# FULL_PUSH=1 runs the full pytest suite before pushing.

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

run() { printf '>> %s\n' "$*" >&2; "$@" || { printf 'PRE-PUSH FAILED at: %s\n' "$*" >&2; exit 1; }; }

resolve_python() {
  if [ -n "${PYTHON_BIN:-}" ]; then
    case "$PYTHON_BIN" in
      */*) [ -x "$PYTHON_BIN" ] || { printf 'PRE-PUSH FAILED: PYTHON_BIN is not executable: %s\n' "$PYTHON_BIN" >&2; return 1; }; printf '%s\n' "$PYTHON_BIN" ;;
      *) command -v "$PYTHON_BIN" 2>/dev/null || { printf 'PRE-PUSH FAILED: PYTHON_BIN is not on PATH: %s\n' "$PYTHON_BIN" >&2; return 1; } ;;
    esac
    return 0
  fi
  for candidate in .venv/bin/python3 .venv/bin/python .venv/Scripts/python.exe; do
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  printf 'PRE-PUSH FAILED: no project Python interpreter; set PYTHON_BIN or create .venv.\n' >&2
  return 1
}

python_bin=$(resolve_python) || exit 1
head=$(git rev-parse HEAD) || exit 1
while read -r local_ref local_oid remote_ref remote_oid; do
  case "$local_oid" in
    0000000000000000000000000000000000000000) continue ;;
  esac
  if [ "$local_oid" != "$head" ]; then
    printf 'PRE-PUSH FAILED: checkout the commit being pushed so it can be checked.\n' >&2
    exit 1
  fi
done

run "$python_bin" -m ruff --version
run "$python_bin" execution/validate_directive_manifest.py
run "$python_bin" execution/validate_folder_contract.py

base=$(git merge-base HEAD origin/main 2>/dev/null || git rev-parse HEAD~1 2>/dev/null || true)
[ -n "$base" ] || { printf 'PRE-PUSH FAILED: no comparison revision.\n' >&2; exit 1; }
run "$python_bin" execution/verify_public_tree.py --pre-push "$base"

changed_py=$(git diff --name-only --diff-filter=ACMR "$base"...HEAD -- '*.py' || true)
if [ -n "$changed_py" ]; then
  # shellcheck disable=SC2086
  run "$python_bin" -m ruff format --check $changed_py
  # shellcheck disable=SC2086
  run "$python_bin" -m ruff check $changed_py
  # shellcheck disable=SC2086
  run "$python_bin" -m pyright --pythonpath "$python_bin" $changed_py
fi

if [ "${FULL_PUSH:-0}" = "1" ]; then
  run "$python_bin" -m pytest -q
else
  changed_tests=$(git diff --name-only --diff-filter=ACMR "$base"...HEAD -- 'tests/test_*.py' 'instruction_tests/test_*.py' || true)
  if [ -n "$changed_tests" ]; then
    # shellcheck disable=SC2086
    run "$python_bin" -m pytest -q $changed_tests
  fi
fi

printf 'pre-push gate passed.\n' >&2
exit 0
