#!/bin/sh
# earnings-summary pre-push gate: mirror its diff-aware CI baseline.

root=$(git rev-parse --show-toplevel) || exit 0
cd "$root" || exit 1

run() { printf '>> %s\n' "$*" >&2; "$@" || { printf 'PRE-PUSH FAILED at: %s\n' "$*" >&2; exit 1; }; }
has() { command -v "$1" >/dev/null 2>&1; }

base=$(git merge-base HEAD origin/main 2>/dev/null || git rev-parse HEAD~1 2>/dev/null || true)
changed=""
if [ -n "$base" ]; then
  changed=$(git diff --name-only --diff-filter=ACMR "$base"...HEAD -- '*.py' \
    | grep -vE '^(alembic/versions/|scratch/)' || true)
fi

if has ruff && [ -n "$changed" ]; then
  case "$(uname -s 2>/dev/null || true)" in
    MINGW*|MSYS*)
      # Git's CRLF checkout makes Ruff's unified diff report unchanged lines as
      # rewrites. CI performs the authoritative LF-normalized changed-line gate.
      printf 'format gate: deferred to LF-normalized CI on Windows\n' >&2
      ;;
    *)
      # shellcheck disable=SC2086
      run python execution/format_changed.py --base "$base" $changed
      ;;
  esac
  status=0
  while IFS= read -r file; do
    [ -z "$file" ] && continue
    head_n=$(ruff check "$file" --output-format=concise 2>/dev/null \
      | grep -cE '^[^:]+:[0-9]+:[0-9]+:' || true)
    base_n=$(git show "$base:$file" 2>/dev/null \
      | ruff check --stdin-filename "$file" --output-format=concise - 2>/dev/null \
      | grep -cE '^[^:]+:[0-9]+:[0-9]+:' || true)
    head_n=${head_n:-0}
    base_n=${base_n:-0}
    if [ "$head_n" -gt "$base_n" ]; then
      printf 'PRE-PUSH FAILED: %s adds %s ruff violation(s) (%s -> %s)\n' \
        "$file" "$((head_n - base_n))" "$base_n" "$head_n" >&2
      ruff check "$file" --output-format=concise >&2 || true
      status=1
    fi
  done <<EOF
$changed
EOF
  [ "$status" -eq 0 ] || exit 1
fi

# The whole-repo strict Pyright comparison is a CI ratchet because the checkout
# carries a reviewed legacy baseline. Full tests remain the local blocking gate,
# or set FAST_PUSH=1 to execute tests on changed test files only.
if has pytest; then
  if [ "${FAST_PUSH:-0}" = "1" ]; then
    changed_tests=$(git diff --name-only --diff-filter=ACMR "$base"...HEAD -- 'tests/test_*.py' 'tests/**/test_*.py' 2>/dev/null || true)
    if [ -n "$changed_tests" ]; then
      run pytest -q $changed_tests
    else
      printf 'FAST_PUSH=1: no changed test files — skipping full pytest suite.\n' >&2
    fi
  else
    run pytest -q
  fi
fi

printf 'pre-push gate passed.\n' >&2
exit 0
