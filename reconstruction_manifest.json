      ]
    },
    {
      "id": "user_state_journal_memory",
      "name": "Analyst Memory & Decision Journal Store",
      "path": "src/user_state",
      "language": "python",
      "entrypoints": [
        "src/user_state/notes.py",
        "src/journal_links.py"
      ],
      "dependencies": [
        "core_data_layer"
      ],
      "test_commands": [
        "pytest tests/test_notes.py -q"
      ],
      "documentation": [
        "DEFINITIONS.md"
      ]
    },
    {
      "id": "cron_automation_scheduler",
      "name": "Windows Scheduler & Morning Automation",
      "path": "cron",
      "language": "batch/xml",
      "entrypoints": [
        "cron/run_fetch_fmp_earnings_calendar.bat",
        "cron/run_python.bat"
      ],
      "dependencies": [
        "pipeline_execution"
      ],
      "test_commands": [],
      "documentation": [
        "cron/SETUP_WINDOWS_SCHEDULER.md"
      ]
    },
    {
      "id": "test_and_verification_suite",
      "name": "Hermetic Testing & Code Quality Ratchets",
      "path": "tests",
      "language": "python",
      "entrypoints": [
        "Makefile",
        "pyproject.toml"
      ],
      "dependencies": [
        "requirements.lock"
      ],
      "test_commands": [
        "pytest tests/test_calendar_end_to_end.py -q"
      ],
      "documentation": [
        "AGENTS.md"
      ]
    }
  ]
}
