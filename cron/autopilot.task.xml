<?xml version="1.0" encoding="UTF-16"?>
<!--
  Windows Task Scheduler definition: monthly portfolio + watchlist autopilot.
  4-stage chain (pull -> process -> track -> memo), see directives/autopilot.md.

  Calendar trigger: 15th of every month at 06:00 local. Aggregators have
  indexed everything by the 15th and the LLM stages (process + track + memo)
  comfortably finish well before market open.

  Import via: schtasks /create /tn "earnings-summary\autopilot" /xml <path> /ru "%USERNAME%"
  See cron\SETUP_WINDOWS_SCHEDULER.md for the full ceremony.
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Earnings-summary monthly autopilot: pull -> process -> track -> memo.</Description>
    <URI>\earnings-summary\autopilot</URI>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <StartBoundary>2026-05-15T06:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByMonth>
        <DaysOfMonth>
          <Day>15</Day>
        </DaysOfMonth>
        <Months>
          <January /><February /><March /><April /><May /><June />
          <July /><August /><September /><October /><November /><December />
        </Months>
      </ScheduleByMonth>
    </CalendarTrigger>
  </Triggers>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT12H</ExecutionTimeLimit>
    <Priority>7</Priority>
    <RestartOnFailure>
      <Interval>PT1H</Interval>
      <Count>2</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>%USERPROFILE%\.gemini\antigravity\scratch\earnings-summary\cron\run_autopilot.bat</Command>
    </Exec>
  </Actions>
</Task>
