# Environment & secrets
venv/
.env
credentials.json
token.json
# Never commit a secrets/ dir (OAuth tokens land under data/secrets/) — belt-and-suspenders
**/secrets/

# Python
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# Ephemeral state (caches, temp audio, intermediates)
.tmp/
.cache/
cache/
logs/
*.log

# Private/generated runtime material. These directories may exist in a local
# checkout, but they are never part of the public source tree.
/scratch/*
!/scratch/seed_kpi_registry.py
/outputs/
/output/
/.harden/state.json
/cron/*.generated.md
!/cron/TASKS.generated.md
/docs/hardening/**/evidence/
/docs/design/
/docs/hardening/
/mockups/*
!/mockups/company_desk_mockup.html
!/mockups/company_research_experience.html
!/mockups/copilot_conversation_prototype.html
!/mockups/evaluation_investment_profile_mockup.html
!/mockups/harvey_sidebar_flow.html
!/mockups/performance_risk_mockup.html
!/mockups/portfolio_copilot_mockup.html
/HOW_TO_USE_REPORTS.html
/directives/self_host*.md

# Generated data — DB, FMP JSON cache, snapshots (1+ GB; reproducible
# from execution/save_fmp_data.py and alembic migrations). Ignore the CONTENTS
# (data/*) rather than the dir itself so specific durable files can be
# re-included below (git won't descend into a fully-ignored `data/`).
data/*
*.db.bak.*
# ...but the deferred-FMP-task backlog is a durable, self-populating record of
# work blocked on FMP access (it is NOT reproducible from a cache re-pull), so it
# is tracked. Mirrors the tracked data/ledger_seed/ precedent.
!data/deferred_fmp/
data/deferred_fmp/*
!data/deferred_fmp/*.jsonl
!data/fmp_canary_manifest.json

# IDE / agent state
.claude/

# Transcript data (user-specific, not checked in). Anchored to repo root —
# an unanchored pattern here also shadowed src/transcripts/ (the P4
# longitudinal-tracking package, docs/design/disclosure_change_build_stack.md).
/transcripts/

# Newly generated DCF workbooks are runtime artifacts. Historical workbooks
# already tracked by Git remain tracked; this prevents scheduled onboarding
# from dirtying the immutable runtime checkout when it creates a new ticker.
/dcf/**/*.xlsx
/dcf/*.xlsx

# Per-account/per-portfolio thesis snapshots are private runtime inputs. The
# public tree may retain anonymized research fixtures elsewhere in this area.
/micro_thesis/holdings/

# Auto-generated per-run thesis tracker markdowns (micro_thesis/holdings/
# JSON schemas ARE checked in; the dated tracker outputs are not).
micro_thesis/thesis-tracker-*-*.md

# Downloaded IR documents (PDFs — large binaries, user-specific)
ir_documents/

# User intake drop folder (any user-supplied artifact lands here for sorting)
_inbox/

# OS junk
Thumbs.db
.DS_Store

# design-system/ (React design-system prototyping sandbox, npm package)
design-system/node_modules/
design-system/dist/

# design-sync (staged converter, build output, machine state)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
